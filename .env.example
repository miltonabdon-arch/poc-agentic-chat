# Configuracao do agent_framework real (agent_platform_oci) - ver
# docs/PROPOSTA-POC.md, secao 6, e docs/ARQUITETURA.md.
#
# LLM_PROVIDER=mock funciona sem qualquer credencial de nuvem (usado por
# padrao nesta PoC - ver agent_framework.llm.providers.MockLLMProvider).
# Se houver credencial de OCI Generative AI de desenvolvimento, trocar para
# oci_openai e preencher OCI_GENAI_*.
LLM_PROVIDER=mock
OCI_GENAI_BASE_URL=
OCI_GENAI_API_KEY=
OCI_GENAI_MODEL=

# Vector store - Chroma local (nao o SQLiteVectorStore do agent_framework -
# ver rag_pipeline/vectorizer.py para o racional dessa decisao deliberada).
CHROMA_DATA_PATH=./chroma_data
