# LLM - ver docs/PROPOSTA-POC.md, secao 6.
# Flow CI&T (LiteLLM proxy): defina as 5 variaveis abaixo.
# Para provider local (Ollama etc): defina so LLM_BASE_URL, LLM_API_KEY, LLM_MODEL.
LLM_BASE_URL=https://flow.ciandt.com/flow-llm-proxy
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Headers obrigatorios do Flow (ignorados se vazios)
FLOW_TENANT=ciandt
FLOW_AGENT=tim-poc

# URLs internas dos servicos (valores default para rodar local sem Docker)
MOCK_SERVICES_URL=http://localhost:8001
GATEWAY_URL=http://localhost:8000
CHAINLIT_URL=http://localhost:8080

# Langfuse — observabilidade avancada (opcional; deixar em branco para desabilitar)
# Obter chaves em http://localhost:3000 apos subir o docker compose
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
